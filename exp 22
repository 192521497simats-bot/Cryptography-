#include <stdio.h>
#include <string.h>

int P10[]={3,5,2,7,4,10,1,9,8,6};
int P8[]={6,3,7,4,8,5,10,9};
int IP[]={2,6,3,1,4,8,5,7};
int IP1[]={4,1,3,5,7,2,8,6};
int EP[]={4,1,2,3,2,3,4,1};
int P4[]={2,4,3,1};

int S0[4][4]={{1,0,3,2},{3,2,1,0},{0,2,1,3},{3,1,3,2}};
int S1[4][4]={{0,1,2,3},{2,0,1,3},{3,0,1,0},{2,1,0,3}};

void perm(char *in,char *out,int *p,int n){
    for(int i=0;i<n;i++) out[i]=in[p[i]-1];
    out[n]='\0';
}

void shift(char *x,int n){
    char t[6];
    strcpy(t,x);
    for(int i=0;i<5;i++) x[i]=t[(i+n)%5];
}

void keys(char *key,char *k1,char *k2){
    char a[11],l[6],r[6],t[11];

    perm(key,a,P10,10);
    strncpy(l,a,5); l[5]='\0';
    strncpy(r,a+5,5); r[5]='\0';

    shift(l,1); shift(r,1);
    strcpy(t,l); strcat(t,r);
    perm(t,k1,P8,8);

    shift(l,2); shift(r,2);
    strcpy(t,l); strcat(t,r);
    perm(t,k2,P8,8);
}

void XOR(char *a,char *b,char *r,int n){
    for(int i=0;i<n;i++) r[i]=((a[i]-'0')^(b[i]-'0'))+'0';
    r[n]='\0';
}

void fk(char *x,char *k){
    char l[5],r[5],e[9],z[9],s[5],p4[5],q[5];

    strncpy(l,x,4); l[4]='\0';
    strncpy(r,x+4,4); r[4]='\0';

    perm(r,e,EP,8);
    XOR(e,k,z,8);

    int row=(z[0]-'0')*2+(z[3]-'0');
    int col=(z[1]-'0')*2+(z[2]-'0');
    int v=S0[row][col];

    s[0]=(v/2)+'0'; s[1]=(v%2)+'0';

    row=(z[4]-'0')*2+(z[7]-'0');
    col=(z[5]-'0')*2+(z[6]-'0');
    v=S1[row][col];

    s[2]=(v/2)+'0'; s[3]=(v%2)+'0';
    s[4]='\0';

    perm(s,p4,P4,4);
    XOR(l,p4,q,4);

    strcpy(x,q);
    strcat(x,r);
}

void sdes(char *in,char *out,char *key,int decrypt){
    char k1[9],k2[9],x[9],t[9];

    keys(key,k1,k2);
    if(decrypt){
        strcpy(t,k1); strcpy(k1,k2); strcpy(k2,t);
    }

    perm(in,x,IP,8);
    fk(x,k1);

    char a[5],b[5];
    strncpy(a,x,4); a[4]='\0';
    strcpy(b,x+4);
    strcpy(x,b); strcat(x,a);

    fk(x,k2);
    perm(x,out,IP1,8);
}

void XOR8(char *a,char *b,char *r){
    XOR(a,b,r,8);
}

int main(){
    char key[]="0111111101";
    char iv[]="10101010";

    char p[3][9]={"00000001","00100011"};
    char c[3][9],x[9],d[3][9];
    char prev[9];

    strcpy(prev,iv);

    for(int i=0;i<2;i++){
        XOR8(p[i],prev,x);
        sdes(x,c[i],key,0);
        strcpy(prev,c[i]);
    }

    printf("Ciphertext: %s%s\n",c[0],c[1]);

    strcpy(prev,iv);

    for(int i=0;i<2;i++){
        sdes(c[i],x,key,1);
        XOR8(x,prev,d[i]);
        strcpy(prev,c[i]);
    }

    printf("Decrypted: %s%s\n",d[0],d[1]);

    return 0;
}
