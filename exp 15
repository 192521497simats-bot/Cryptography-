text = input("Enter ciphertext: ")
freq = "ETAOINSHRDLCUMWFGYPBVKJXQZ"

def decrypt(s,k):
    return ''.join(
        chr((ord(c.upper())-65-k)%26+65) if c.isalpha() else c
        for c in s
    )

results = []

for k in range(26):
    p = decrypt(text,k)
    score = sum(p.count(x) for x in freq[:6])
    results.append((score,k,p))

results.sort(reverse=True)

for score,k,p in results[:10]:
    print(k, ":", p)
