#include <stdio.h>
#include <string.h>

int P10[]={3,5,2,7,4,10,1,9,8,6};
int P8[]={6,3,7,4,8,5,10,9};
int IP[]={2,6,3,1,4,8,5,7};
int IP1[]={4,1,3,5,7,2,8,6};
int EP[]={4,1,2,3,2,3,4,1};
int P4[]={2,4,3,1};

int S0[4][4]={{1,0,3,2},{3,2,1,0},{0,2,1,3},{3,1,3,2}};
int S1[4][4]={{0,1,2,3},{2,0,1,3},{3,0,1,0},{2,1,0,3}};

void perm(char*a,char*b,int*p,int n){
    for(int i=0;i<n;i++) b[i]=a[p[i]-1];
    b[n]=0;
}

void shift(char*x,int n){
    char t[6]; strcpy(t,x);
    for(int i=0;i<5;i++) x[i]=t[(i+n)%5];
}

void keys(char*k,char*k1,char*k2){
    char a[11],l[6],r[6],t[11];
    perm(k,a,P10,10);
    strncpy(l,a,5);l[5]=0;
    strcpy(r,a+5);

    shift(l,1);shift(r,1);
    strcpy(t,l);strcat(t,r);
    perm(t,k1,P8,8);

    shift(l,2);shift(r,2);
    strcpy(t,l);strcat(t,r);
    perm(t,k2,P8,8);
}

void xo(char*a,char*b,char*r,int n){
    for(int i=0;i<n;i++)r[i]=((a[i]-48)^(b[i]-48))+48;
    r[n]=0;
}

void fk(char*x,char*k){
    char l[5],r[5],e[9],z[9],s[5],p[5],q[5];
    strncpy(l,x,4);l[4]=0;strcpy(r,x+4);
    perm(r,e,EP,8);xo(e,k,z,8);

    int row=(z[0]-48)*2+z[3]-48;
    int col=(z[1]-48)*2+z[2]-48;
    int v=S0[row][col];
    s[0]=v/2+48;s[1]=v%2+48;

    row=(z[4]-48)*2+z[7]-48;
    col=(z[5]-48)*2+z[6]-48;
    v=S1[row][col];
    s[2]=v/2+48;s[3]=v%2+48;s[4]=0;

    perm(s,p,P4,4);xo(l,p,q,4);
    strcpy(x,q);strcat(x,r);
}

void sdes(char*in,char*out,char*key){
    char k1[9],k2[9],x[9],a[5],b[5];
    keys(key,k1,k2);
    perm(in,x,IP,8);
    fk(x,k1);

    strncpy(a,x,4);a[4]=0;strcpy(b,x+4);
    strcpy(x,b);strcat(x,a);

    fk(x,k2);
    perm(x,out,IP1,8);
}

void xor8(char*a,char*b,char*r){xo(a,b,r,8);}

int main(){
    char key[]="0111111101";
    char p[][9]={
        "00000001",
        "00000010",
        "00000100"
    };

    char c[3][9],ks[9],ctr[9];

    for(int i=0;i<3;i++){
        sprintf(ctr,"%08d",i);  /* replaced below */
        for(int j=0;j<8;j++)
            ctr[7-j]=((i>>j)&1)+'0';
        ctr[8]=0;

        sdes(ctr,ks,key);
        xor8(p[i],ks,c[i]);
    }

    printf("Ciphertext: ");
    for(int i=0;i<3;i++)printf("%s",c[i]);

    printf("\nDecrypted: ");
    for(int i=0;i<3;i++){
        for(int j=0;j<8;j++)
            ctr[7-j]=((i>>j)&1)+'0';
        ctr[8]=0;

        sdes(ctr,ks,key);
        xor8(c[i],ks,ctr);
        printf("%s",ctr);
    }

    return 0;
}
