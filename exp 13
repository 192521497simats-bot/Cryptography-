import numpy as np

P = np.array([[0,2],[1,3]])      # plaintext pairs
C = np.array([[1,3],[2,5]])      # ciphertext pairs

det = int(round(np.linalg.det(P))) % 26
inv = pow(det, -1, 26)

adj = np.array([[3,-2],[-1,0]])
Pinv = (inv * adj) % 26

K = C.dot(Pinv) % 26

print("Recovered Key:")
print(K)
