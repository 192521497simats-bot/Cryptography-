#include <stdio.h>
#include <string.h>

int main(){
    char p[100];
    int key[100],n;

    printf("Enter plaintext: ");
    scanf("%s",p);

    n=strlen(p);

    printf("Enter %d key values (0-25):\n",n);

    for(int i=0;i<n;i++)
        scanf("%d",&key[i]);

    printf("Ciphertext: ");

    for(int i=0;i<n;i++){
        int x=p[i]-'A';
        printf("%c",(x+key[i])%26+'A');
    }

    printf("\n");

    return 0;
}
