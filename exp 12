import numpy as np

K = np.array([[9,4],[5,7]])
text = "MEET ME AT THE USUAL PLACE AT TEN RATHER THAN EIGHT OCLOCK"
text = ''.join(c for c in text.upper() if c.isalpha())

if len(text) % 2:
    text += "X"

cipher = ""

for i in range(0,len(text),2):
    p = np.array([[ord(text[i])-65],
                  [ord(text[i+1])-65]])
    c = K.dot(p) % 26
    cipher += chr(c[0,0]+65) + chr(c[1,0]+65)

print("Cipher:", cipher)

# Decryption
det = int(round(np.linalg.det(K))) % 26
invdet = pow(det, -1, 26)

adj = np.array([[7,-4],[-5,9]])
Kinv = (invdet * adj) % 26

plain = ""
for i in range(0,len(cipher),2):
    c = np.array([[ord(cipher[i])-65],
                  [ord(cipher[i+1])-65]])
    p = Kinv.dot(c) % 26
    plain += chr(int(p[0,0])+65) + chr(int(p[1,0])+65)

print("Plain :", plain)
