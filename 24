#include <stdio.h>

int main(){
    int n=3599, e=31;
    int p=0,q=0;

    for(int i=2;i<n;i++){
        if(n%i==0){
            p=i;
            q=n/i;
            break;
        }
    }

    int phi=(p-1)*(q-1);

    for(int d=1;d<phi;d++){
        if((e*d)%phi==1){
            printf("p = %d\nq = %d\n",p,q);
            printf("phi(n) = %d\n",phi);
            printf("Private key d = %d\n",d);
            break;
        }
    }

    return 0;
}
