#include <stdio.h>

long long power(long long a,long long e,long long n){
    long long r=1;

    while(e){
        if(e%2) r=r*a%n;
        a=a*a%n;
        e/=2;
    }

    return r;
}

int main(){
    int n=3233;
    int e=17;
    int ciphertext;

    printf("Enter ciphertext: ");
    scanf("%d",&ciphertext);

    for(int m=0;m<26;m++){
        if(power(m,e,n)==ciphertext)
            printf("Recovered plaintext = %d\n",m);
    }

    printf("Attack works because only 26 possible messages exist.\n");

    return 0;
}
