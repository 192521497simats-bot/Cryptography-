#include <stdio.h>

int inverse(int a){
    for(int i=0;i<26;i++)
        if((a*i)%26==1)
            return i;
    return -1;
}

int main(){
    /* Plaintext pairs: HI and AT */
    int P[2][2]={{7,0},{8,19}};

    /* Corresponding ciphertext: TC and FR */
    int C[2][2]={{19,5},{2,17}};

    int det=(P[0][0]*P[1][1]-P[0][1]*P[1][0])%26;

    if(det<0) det+=26;

    int inv=inverse(det);

    if(inv==-1){
        printf("Matrix cannot be inverted.\n");
        return 0;
    }

    int PI[2][2];

    PI[0][0]=P[1][1]*inv%26;
    PI[0][1]=-P[0][1]*inv%26;
    PI[1][0]=-P[1][0]*inv%26;
    PI[1][1]=P[0][0]*inv%26;

    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++){
            PI[i][j]%=26;
            if(PI[i][j]<0) PI[i][j]+=26;
        }

    int K[2][2]={0};

    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            for(int k=0;k<2;k++)
                K[i][j]=(K[i][j]+C[i][k]*PI[k][j])%26;

    printf("Recovered Hill key:\n");

    for(int i=0;i<2;i++)
        printf("%d %d\n",K[i][0],K[i][1]);

    return 0;
}
