#include <stdio.h>

int main(){
    char text[500];
    int count[26]={0};

    printf("Enter ciphertext:\n");
    fgets(text,500,stdin);

    for(int i=0;text[i];i++)
        if(text[i]>='A' && text[i]<='Z')
            count[text[i]-'A']++;

    int max=0;

    for(int i=1;i<26;i++)
        if(count[i]>count[max])
            max=i;

    /* Assume most frequent letter is E */
    int shift=(max-4+26)%26;

    printf("Estimated key = %d\n",shift);

    printf("Possible plaintext:\n");

    for(int i=0;text[i];i++){
        if(text[i]>='A' && text[i]<='Z')
            printf("%c",(text[i]-'A'-shift+26)%26+'A');
        else
            putchar(text[i]);
    }

    return 0;
}
